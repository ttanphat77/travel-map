scripts/data/.cache/

# Dữ liệu người dùng do server ghi ra. Dấu "/" ở đầu để chỉ chặn thư mục data ở gốc dự án.
/data/

# File tạm của TypeScript và hệ điều hành
*.tsbuildinfo
.DS_Store
